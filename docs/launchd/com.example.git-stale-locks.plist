<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.git-stale-locks</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_HOME/.local/bin/git-stale-locks</string>
	</array>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>REPLACE_HOME/.local/state/fleet/git-stale-locks/launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_HOME/.local/state/fleet/git-stale-locks/launchd.stderr.log</string>
</dict>
</plist>
