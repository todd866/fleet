<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.fleet-snapshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_HOME/.local/bin/fleet</string>
		<string>morning</string>
		<string>collect</string>
		<string>--local</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>REPLACE_HOME/.local/state/fleet/morning/snapshot.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_HOME/.local/state/fleet/morning/snapshot.stderr.log</string>
</dict>
</plist>
