<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.placement-status</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>REPLACE_HOME/.local/bin/diskmap peers; exec REPLACE_HOME/.local/bin/placement status</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>REPLACE_HOME/.local/state/placement/launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_HOME/.local/state/placement/launchd.stderr.log</string>
</dict>
</plist>
