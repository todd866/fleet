#!/usr/bin/env python3
"""Check that the named UI journey ran and passed in this Xcode result bundle."""
import argparse
import json
from pathlib import Path
import subprocess
import sys


def ui_cases(node, inside_ui_bundle=False):
    inside_ui_bundle |= node["nodeType"] == "UI test bundle"
    if inside_ui_bundle and node["nodeType"] == "Test Case":
        yield node
    for child in node.get("children", []):
        yield from ui_cases(child, inside_ui_bundle)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("xcresult", type=Path)
    parser.add_argument("test", help="Exact Suite/testMethod() identifier from Xcode")
    args = parser.parse_args()

    def report(section):
        return json.loads(subprocess.check_output([
            "xcrun", "xcresulttool", "get", "test-results", section, "--path", args.xcresult,
        ]))

    summary = report("summary")
    if summary["result"] != "Passed":
        sys.exit(f"Test run result: {summary['result']}")
    cases = [case for root in report("tests")["testNodes"] for case in ui_cases(root)
             if case.get("nodeIdentifier") == args.test]
    if not cases or any(case.get("result") != "Passed" for case in cases):
        sys.exit(f"Missing or unsuccessful UI journey: {args.test}")
    print(f"Passed: {args.test}\nResult bundle: {args.xcresult.resolve()}")


if __name__ == "__main__":
    main()
