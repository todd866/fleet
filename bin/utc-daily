#!/bin/zsh
# utc-daily: run a command once a day (or once a week) at a UTC time, from a launchd job that
# ticks every few minutes.
#
#   utc-daily --label NAME --at HH:MM [--at HH:MM ...] [--weekday 0-6] [--retry] -- command [args ...]
#   utc-daily status [NAME]          last run of each job: UTC time, slot, exit code
#
# Why: launchd's StartCalendarInterval is local time, and worse, the local time of the zone the
# Mac booted in. A laptop that travels fires every calendar job hours off, and three Macs in
# different places disagree about when "06:30" is. A schedule kept in UTC means the same
# instant everywhere. launchd cannot do that, so the plist uses StartInterval (zone-free) and
# this script decides whether a run is due.
#
# In the plist: ProgramArguments = /bin/zsh, this file, the options, "--", the command.
# The command is run as a child and never exec'd, so macOS privacy checks keep seeing /bin/zsh.
#
# A run is due when a slot has passed, has not started, and is no more than 18 hours old
# ($UTC_DAILY_CATCHUP seconds). A Mac that was asleep at the slot runs at its next tick, also when
# that tick falls after midnight UTC. A Mac that was off for longer skips that slot.
# --weekday is the UTC weekday of the slot, 0 = Sunday.
# A run cut short (restart, power loss, launchd's TERM at shutdown) is tried once more at the next
# tick; a tick that finds the earlier run still going does nothing.
# --retry: a run that fails leaves its slot open, so the next start tries again. For plists
# with KeepAlive { SuccessfulExit = false }, where launchd restarts a failed job until it works.
#
# State: ~/.local/state/utc-daily/NAME/  done-HHMM (UTC date of the slot that last started),
# running (slot, date, pid, boot time, attempt; empty when idle) and
# last (one line: start epoch, end epoch, slot, exit code). A tick that is not due prints
# nothing and exits 0; a tick that runs exits with the command's code.
emulate -L zsh
setopt no_unset pipe_fail

root=${UTC_DAILY_STATE:-$HOME/.local/state/utc-daily}

if [[ ${1:-} == status ]]; then
  for d in $root/${2:-*}(N/); do
    marks=($d/done-*(N))
    (( ${#marks} )) || [[ -f $d/last ]] || continue     # not a job's folder
    [[ -f $d/last ]] || { print -r -- "${d:t}  never run"; continue }
    read -r start end slot rc < $d/last
    print -r -- "${d:t}  $(date -u -r $start '+%Y-%m-%d %H:%MZ')  slot ${slot}Z  exit $rc  $(( end - start )) s"
  done
  exit 0
fi

label='' weekday='' retry=0
typeset -a slots marks
while (( $# )); do
  case $1 in
    --label) label=$2; shift 2 ;;
    --at) slots+=($2); shift 2 ;;
    --weekday) weekday=$2; shift 2 ;;
    --retry) retry=1; shift ;;
    --) shift; break ;;
    *) print -u2 -r -- "utc-daily: unknown option $1"; exit 64 ;;
  esac
done
[[ -n $label && $label != */* && $label != .* ]] || { print -u2 "utc-daily: --label NAME is required"; exit 64 }
(( ${#slots} )) || { print -u2 "utc-daily: at least one --at HH:MM is required"; exit 64 }
(( $# )) || { print -u2 "utc-daily: no command after --"; exit 64 }
for s in $slots; do
  [[ $s == [0-2][0-9]:[0-5][0-9] && ${s%%:*} -le 23 ]] || { print -u2 -r -- "utc-daily: bad time $s"; exit 64 }
done
[[ -z $weekday || $weekday == [0-6] ]] || { print -u2 "utc-daily: --weekday is 0-6, Sunday is 0"; exit 64 }

now=${UTC_DAILY_NOW:-$(date -u +%s)}
window=${UTC_DAILY_CATCHUP:-64800}
day0=$(( now - now % 86400 ))
boot=$(/usr/sbin/sysctl -n kern.boottime 2>/dev/null)
boot=${${boot#*sec = }%%,*}

dir=$root/$label
mkdir -p $dir || exit 73

# An earlier run that never finished. Still going: leave it alone. Cut short (a restart, a power
# loss, a kill): its slot opens again, once. A run that is cut twice stays done for the day.
prevkey='' prevdate='' prevtry=0
if [[ -s $dir/running ]]; then
  read -r rkey rdate rpid rboot rtry < $dir/running
  if [[ $rboot == $boot && $rpid == <-> ]] && kill -0 $rpid 2>/dev/null; then
    exit 0
  fi
  prevkey=$rkey prevdate=$rdate prevtry=${rtry:-1}
  if (( prevtry < 2 )) && [[ -f $dir/done-$rkey && $(<$dir/done-$rkey) == $rdate ]]; then
    : > $dir/done-$rkey
  fi
  : > $dir/running
fi

# Each slot's most recent instant: today's if the clock has passed it, otherwise yesterday's. The
# latest one that has not started and is no more than the catch-up window old is due. Earlier ones
# are marked too, so a Mac that slept through two slots runs once, not twice in a row.
# A slot seen for the first time after its day has ended is marked, not run: installing a job
# does not fire last night's slot.
due='' duet=0 duedate=''
typeset -A slotdate slottime
for s in ${(o)slots}; do
  key=${s/:/}
  t=$(( day0 + 10#${s%%:*} * 3600 + 10#${s##*:} * 60 ))
  (( t > now )) && (( t -= 86400 ))
  d=$(date -u -r $t +%Y-%m-%d)
  slotdate[$key]=$d slottime[$key]=$t
  if [[ ! -f $dir/done-$key ]]; then
    (( t < day0 )) && { print -r -- $d > $dir/done-$key; continue }
  elif [[ $(<$dir/done-$key) == $d ]]; then
    continue
  fi
  (( now - t <= window )) || continue
  [[ -z $weekday || $(date -u -r $t +%w) == $weekday ]] || continue
  (( t > duet )) && { due=$s duet=$t duedate=$d }
done
[[ -n $due ]] || exit 0
for key in ${(k)slottime}; do
  (( slottime[$key] <= duet )) && print -r -- $slotdate[$key] > $dir/done-$key
done

duekey=${due/:/}
try=1
[[ $duekey == $prevkey && $duedate == $prevdate ]] && try=$(( prevtry + 1 ))
print -r -- "$duekey $duedate $$ $boot $try" > $dir/running

cut=0
"$@" &
child=$!
trap 'cut=1; kill -TERM $child 2>/dev/null' TERM INT HUP
wait $child; rc=$?
while kill -0 $child 2>/dev/null; do wait $child; rc=$?; done
print -r -- "$now $(date -u +%s) $due $rc" > $dir/last.tmp && mv -f $dir/last.tmp $dir/last
if (( cut && try < 2 )); then
  # ended from outside (launchd at shutdown): the next tick tries once more
  : > $dir/done-$duekey
  print -r -- "$duekey $duedate - - $try" > $dir/running
else
  : > $dir/running
  (( retry && rc != 0 )) && : > $dir/done-$duekey
fi
exit $rc
