#!/usr/bin/env python3
"""home-mirror: copy this Mac's home folder to the home hub, so the hub's backup can take it off-site.

A laptop's own backup client is the thing being avoided (IDrive's macOS app). Instead the laptop
pushes its home to a folder on the hub over ssh, once a day, when it is on an unmetered link and on
mains power; the hub's `idrive-ingest` backs that folder up with everything else. The hub copy is
also the "verified on the hub" half of an offload.

  home-mirror run [--force] [--dry-run]   one pass when due (or --force); writes status.json
  home-mirror run --dry-run --personal    plan each personal data set, copy nothing, print the result
  home-mirror status                       status.json

Config ~/.config/fleet/home-mirror.json:
  {"hub": "hub", "dest": "/Volumes/Drive/laptop-home", "every_h": 20, "min_free_gb": 40,
   "require_ac": true, "exclude": ["/Library/Caches/", "node_modules/"],
   "skip_dataless": ["Desktop", "Documents"]}
`exclude` lines are rsync patterns, anchored at the home folder when they start with "/"; a line may
be {"pattern": ..., "why": ...} so every skip says why (a coverage audit reads the reasons).
`first_pass_free_gb`: the first pass waits until the destination has this much free.
Files that are cloud placeholders (dataless) under `skip_dataless` are never read: reading one
makes the cloud download it. Deleted or changed files are moved to `<dest>-versions/<stamp>` on
the hub, not lost. On the hub the copy runs under `disk-slot`, so it never shares a disk with
another heavy job. State: ~/.local/state/home-mirror/.

Two passes, each with its own space check and its own record in status.json. The personal pass
goes first: the `class = "personal-unique"` data sets in ~/.config/fleet/placement.toml whose
paths exist under this home, one data set at a time in the file's order (a data set's optional
integer `priority` moves it: lower first, none counts as 0), each to the same place in the same
tree, so the full pass sends nothing twice. A set is copied when its own plan plus `min_free_gb`
fits in what is free now, never `first_pass_free_gb`; one that does not fit waits and the sets
after it still go, so what cannot be replaced is copied even while the full home, or one large
set, does not fit. Its record is `personal` in status.json, with one entry per set in `sets`; the
top-level fields stay the full pass's. A Mac with no placement.toml has no personal pass.

A laptop's home holds keys and personal files, so on a removable drive the copy belongs inside an
encrypted disk image: set "hub_prepare": "~/.local/bin/home-mirror hub-attach", point `dest` into
the image's volume and `free_path` at the drive that holds it. On the hub, `home-mirror
hub-attach` reads ~/.config/fleet/home-mirror-hub.json:
  {"image": "<drive>/laptop-home.sparsebundle", "volname": "Laptop-Home", "size": "1300g",
   "password_cmd": "a command that prints the image password"}
and attaches the image, creating it (APFS, AES-256) on first use. The password goes from
`password_cmd` to hdiutil on stdin; it is never printed or written.
"""
import argparse
import fcntl
import json
import os
import pathlib
import re
import signal
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("HOME_MIRROR_CONFIG", HOME / ".config/fleet/home-mirror.json"))
STATE = pathlib.Path(os.environ.get("HOME_MIRROR_STATE", HOME / ".local/state/home-mirror"))
RSYNC = next((p for p in ("/opt/homebrew/bin/rsync", "/usr/local/bin/rsync") if os.path.exists(p)), "rsync")
REMOTE_RSYNC = "/opt/homebrew/bin/rsync"
METERED = HOME / ".local/state/METERED_LINK"
WILD = re.compile(r"([*?\[\]\\])")
# The fleet's one reader of placement.toml data sets is the morning probe's. TOML needs Python 3.11
# and this script also runs under macOS's own older python3, so the reader is run by whichever
# interpreter has it.
PROBE = pathlib.Path(__file__).resolve().parents[1] / "fleet/morning/probe.py"
READ_DATASETS = ("import json, runpy, sys; probe = runpy.run_path(sys.argv[1]); "
                 "print(json.dumps(probe['_placement_datasets'](sys.argv[2]) if probe['tomllib'] else None))")
PYTHONS = ("/opt/homebrew/bin/python3", "/usr/local/bin/python3")


def load_config(path=CONFIG):
    cfg = json.loads(pathlib.Path(path).read_text())
    cfg.setdefault("every_h", 20)
    cfg.setdefault("min_free_gb", 40)
    cfg.setdefault("require_ac", True)
    cfg.setdefault("exclude", [])
    cfg.setdefault("skip_dataless", [])
    cfg.setdefault("first_pass_free_gb", 0)
    cfg.setdefault("slice_s", 1800)
    cfg["exclude"] = [e["pattern"] if isinstance(e, dict) else e for e in cfg["exclude"]]
    for key in ("hub", "dest"):
        if not cfg.get(key):
            raise SystemExit(f"home-mirror: config needs {key}")
    return cfg


def rsync_pattern(rel):
    """An anchored rsync pattern matching exactly this relative path (wildcards escaped)."""
    return "/" + WILD.sub(r"\\\1", rel)


def placement_datasets(run=subprocess.run):
    """Data sets declared in this home's placement.toml, or None when no interpreter could read it."""
    for python in dict.fromkeys((sys.executable, *PYTHONS)):
        try:
            done = run([python, "-c", READ_DATASETS, str(PROBE), str(HOME)],
                       capture_output=True, text=True, timeout=60)
            rows = json.loads(done.stdout)
        except (OSError, subprocess.SubprocessError, ValueError):
            continue
        if isinstance(rows, list):
            return rows
    return None


def home_relative(path):
    """A data set path as a path under this home, or None when it is not inside it."""
    text = str(path)[2:] if str(path).startswith("~/") else str(path)
    if text.startswith("/"):
        try:
            text = str(pathlib.PurePosixPath(text).relative_to(HOME))
        except ValueError:
            return None
    rel = os.path.normpath(text)
    return None if rel in (".", "..") or rel.startswith("../") else rel


def personal_sets(cfg, run=subprocess.run):
    """What the personal pass copies, in the order it copies it: placement.toml's personal-unique
    data sets, each with its paths that exist under this home, so a newly declared data set is
    covered with no change here. The order is the file's, which is the owner's priority; a data
    set's optional integer `priority` moves it (lower first, none counts as 0). A path that is not
    on this Mac, or that the config excludes, is named in `skipped`; within a set a path inside
    another is dropped (its parent carries it). `state` is set when there is no pass to run: "not
    applicable" (no placement.toml, or nothing of it here) or "failed" (the file could not be read,
    which must never look like a copy)."""
    out = {"sets": [], "skipped": [], "state": None}
    if not (HOME / ".config/fleet/placement.toml").is_file():
        out["state"] = "not applicable: no placement.toml on this Mac"
        return out
    rows = placement_datasets(run)
    if not rows:
        out["state"] = "failed: placement.toml gave no data sets (unreadable, or no python3 with tomllib)"
        return out
    excluded = excepted(cfg["exclude"])
    for ds in sorted(rows, key=lambda ds: ds.get("priority") or 0):   # stable: ties keep the file's order
        if ds.get("class") != "personal-unique":
            continue
        found = set()
        for path in ds.get("paths") or []:
            rel = home_relative(path)
            if rel is None:
                why = "outside this home"
            elif any(rel == e or rel.startswith(e + "/") for e in excluded):
                why = "excluded in home-mirror.json"
            elif not os.path.lexists(HOME / rel):
                why = "not on this Mac"
            else:
                found.add(rel)
                continue
            out["skipped"].append({"path": path, "dataset": ds.get("name"), "why": why})
        if found:
            out["sets"].append({"name": str(ds.get("name")),
                                "paths": sorted(p for p in found if not any(p.startswith(q + "/") for q in found))})
    if not out["sets"]:
        out["state"] = "not applicable: no personal data set of placement.toml is on this Mac"
    return out


def needed_gb(cfg, planned_bytes):
    """Free space a planned transfer needs: its size, a tenth of headroom, and the reserve."""
    return planned_bytes / 1e9 * 1.10 + float(cfg["min_free_gb"])


def still_waiting(cfg, rec, free, now):
    """True when this set's own recent plan still does not fit, so it is not planned again: that
    would hold the hub's disk slot to learn the same thing. Only that set is put off; a plan older
    than `preflight_cache_h`, or more room than it needed, is a new plan."""
    if not str(rec.get("state")).startswith("waiting for space") or not rec.get("planned_bytes"):
        return False
    age, needed = now - int(rec.get("attempt_epoch") or 0), needed_gb(cfg, rec["planned_bytes"])
    if age < 0 or age > float(cfg.get("preflight_cache_h", 6)) * 3600 or free >= needed:
        return False
    rec.update(required_free_gb=needed,
               state=f"waiting for space: {free:.1f} GB free, recent plan needs {needed:.1f} GB including reserve")
    return True


def summarise(personal, cfg, problem=None):
    """The personal record's own fields, from its per-set records: the counts, what counts as
    copied for placement, and one state (the worst set's). `last_success_epoch` is the oldest of
    the sets' last good copies, and is there only when every set has one."""
    if problem:
        personal["state"] = problem
        if problem.startswith("not applicable"):
            personal.update(paths=[], sets=[], copied_paths=[])
            personal.pop("last_success_epoch", None)
        return
    sets = personal.get("sets") or []
    done = [s for s in sets if s.get("last_success_epoch")]
    waiting = [s for s in sets if str(s.get("state")).startswith("waiting for space")]
    personal.update(sets_total=len(sets), sets_copied=len(done), sets_waiting=len(waiting),
                    planned_bytes=sum(s.get("planned_bytes") or 0 for s in waiting),
                    **{key: sum(s.get(key) or 0 for s in done) for key in ("files", "bytes", "total_bytes")})
    personal.pop("required_free_gb", None)
    if waiting:
        personal["required_free_gb"] = needed_gb(cfg, personal["planned_bytes"])
    personal.pop("last_success_epoch", None)
    if sets and len(done) == len(sets):
        personal["last_success_epoch"] = min(s["last_success_epoch"] for s in done)
        personal.setdefault("first_success_epoch", personal["last_success_epoch"])
    # A path earns a row for placement when its set is copied. Not twice (inside another copied
    # path), and not inside a path of a set still to copy: placement would read the smaller copy as
    # a copy of the larger.
    have = {p for s in done for p in s["paths"]}
    lack = {p for s in sets if not s.get("last_success_epoch") for p in s["paths"]}
    personal["copied_paths"] = sorted(p for p in have if not any(p.startswith(q + "/") for q in have | lack))
    rank = ("failed", "deferred", "slice used", "queued", "waiting for space", "skipped")
    worst = min((s for s in sets if s.get("state") != "ok"), default=None,
                key=lambda s: next((i for i, word in enumerate(rank) if str(s.get("state")).startswith(word)), len(rank)))
    personal["state"] = "ok" if worst is None else \
        f"{worst.get('state')} [{worst['name']}]; {len(done)} of {len(sets)} sets copied"


def dataless(home, folders, run=subprocess.run):
    """Relative paths of cloud placeholder files under these folders (BSD find -flags)."""
    out = []
    for folder in folders:
        root = home / folder
        if not root.is_dir():
            continue
        done = run(["/usr/bin/find", str(root), "-flags", "+dataless", "-type", "f"],
                   capture_output=True, text=True, errors="replace", timeout=1800)
        if getattr(done, "returncode", 0) != 0:
            raise RuntimeError(f"placeholder scan failed for {folder}; refusing to read cloud files")
        for line in done.stdout.splitlines():
            if line.startswith(str(home) + "/"):
                out.append(line[len(str(home)) + 1:])
    return out


def on_ac(run=subprocess.run):
    try:
        out = run(["pmset", "-g", "batt"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "AC Power" in out


def idle_allowed(cfg):
    if not cfg.get("require_idle"):
        return True
    try:
        if os.stat("/dev/console").st_uid != os.getuid():
            return False
        result = subprocess.run(["/usr/sbin/ioreg", "-c", "IOHIDSystem"],
                                capture_output=True, text=True, timeout=10)
        found = re.search(r'"HIDIdleTime"\s*=\s*(\d+)', result.stdout)
        return bool(found and int(found.group(1)) >= int(cfg.get("idle_seconds", 300)) * 10**9)
    except (OSError, subprocess.SubprocessError):
        return False


def guarded_copy(args, handle, cfg, slice_s=None):
    """End our process group cleanly if the shared laptop becomes active, loses mains, or uses its disk slice."""
    limit = int(cfg.get("slice_s") or 0) if slice_s is None else int(slice_s)
    poll_s = min(15.0, max(0.05, float(limit))) if limit > 0 else 15.0
    started = time.monotonic()
    child = subprocess.Popen(args, stdout=handle, stderr=subprocess.STDOUT, start_new_session=True)
    try:
        while True:
            try:
                return subprocess.CompletedProcess(args, child.wait(timeout=poll_s))
            except subprocess.TimeoutExpired:
                if limit > 0 and (time.monotonic() - started) >= limit:
                    handle.write(f"\nSlice used ({limit}s); partial copy retained, continues next pass.\n")
                    handle.flush()
                    return subprocess.CompletedProcess(args, 75)
                if not idle_allowed(cfg) or (cfg.get("require_ac") and not on_ac()) or METERED.exists():
                    handle.write("\nDeferred: laptop activity, power or network changed; partial copy retained.\n")
                    handle.flush()
                    return subprocess.CompletedProcess(args, 75)
    finally:
        if child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            child.wait()


def priority_busy(cfg, run=subprocess.run):
    """Yield new attempts to an already-running hub archive batch; never stop a copy."""
    lock = cfg.get('hub_priority_lock')
    if not lock:
        return False
    try:
        check = run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg['hub'],
                     '/usr/bin/lockf -t 0 ' + sh(lock) + ' /usr/bin/true'],
                    capture_output=True, timeout=30)
        return check.returncode != 0
    except (OSError, subprocess.SubprocessError):
        return True


def cached_capacity(cfg, free, now):
    """Only defer from a recent plan. Never authorize a copy using cached capacity."""
    log = STATE / 'preflight.log'
    try:
        age = now - log.stat().st_mtime
        if age < 0 or age > float(cfg.get('preflight_cache_h', 6)) * 3600:
            return None
        planned = stats(log.read_text(errors='replace'))
        if 'bytes' not in planned:
            return None
        needed = planned['bytes'] / 1e9 * 1.10 + float(cfg['min_free_gb'])
        if free < needed:
            return dict(planned_bytes=planned['bytes'], required_free_gb=needed,
                        state=f'waiting for space: {free:.1f} GB free, recent plan needs {needed:.1f} GB including reserve')
    except (OSError, ValueError, TypeError):
        pass
    return None


def remote_free_gb(cfg, run=subprocess.run):
    # `free_path`: where free space is really measured. Inside a sparse disk image the image's own
    # size shows as free; the drive that holds the image is what fills up.
    parent = cfg.get("free_path") or os.path.dirname(cfg["dest"].rstrip("/")) or "/"
    try:
        done = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                    f"/bin/df -k {sh(parent)} | tail -1"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    parts = done.stdout.split()
    if done.returncode != 0 or len(parts) < 4 or not parts[3].isdigit():
        return None
    return int(parts[3]) * 1024 / 1e9


def sh(text):
    return "'" + str(text).replace("'", "'\\''") + "'"


def rsync_args(cfg, exclude_file, stamp, dry=False, verify=False, sources=None):
    """The copy's command line. `sources` (the personal pass) limits it to those home-relative paths:
    --relative puts each at the same path under the destination as the whole-home copy would, so
    anchored excludes still match, and nothing outside those paths is sent, deleted or replaced."""
    dest = cfg["dest"].rstrip("/")
    remote = (f"$HOME/.local/bin/disk-slot --label home-mirror --wait 7200 {sh(os.path.dirname(dest))} -- "
              f"{REMOTE_RSYNC}")
    if cfg.get("required_free_gb") and not dry:
        floor = int(float(cfg["required_free_gb"]) * 1e9 / 1024)
        check_path = cfg.get("free_path") or os.path.dirname(dest)
        script = (f"available=$(df -Pk {sh(check_path)} | awk 'NR==2 {{print $4}}'); "
                  f"[ \"${{available:-0}}\" -ge {floor} ] || {{ echo 'destination reserve changed' >&2; exit 75; }}; "
                  f'exec {REMOTE_RSYNC} "$@"')
        remote = (f"$HOME/.local/bin/disk-slot --label home-mirror --wait 7200 {sh(os.path.dirname(dest))} -- "
                  f"/bin/sh -c {sh(script)} home-mirror")
    args = [RSYNC, "-aHX", "--delete", "--delete-excluded", "--partial", "--stats",
            "--backup", f"--backup-dir={dest}-versions/{stamp}",
            "--exclude-from", str(exclude_file), "--rsync-path", remote,
            "-e", "ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30"]
    if cfg.get("bwlimit_kib"):
        args.append(f"--bwlimit={int(cfg['bwlimit_kib'])}")
    if verify:
        args += ["--checksum", "--itemize-changes"]
    if dry or verify:
        args.append("--dry-run")
    if sources is not None:
        return args + ["--relative", *[f"{HOME}/./{rel}" for rel in sources], f"{cfg['hub']}:{dest}/"]
    return args + [str(HOME) + "/", f"{cfg['hub']}:{dest}/"]


def stats(text):
    out = {}
    for key, label in (("files", "Number of regular files transferred"),
                       ("bytes", "Total transferred file size"), ("total_bytes", "Total file size")):
        hit = re.search(label + r":\s*([\d,]+)", text or "")
        if hit:
            out[key] = int(hit.group(1).replace(",", ""))
    return out


def excepted(patterns):
    """Home-relative folders the copy leaves out: the anchored, wildcard-free excludes."""
    out = []
    for p in patterns:
        if p.startswith("/") and not WILD.search(p):
            rel = p.strip("/")
            if rel:
                out.append(rel)
    return sorted(set(out))


def replica_rows(cfg, status, entries, held_at=None):
    """Rows for placement (replicas.d/home-mirror.json): one per top-level home entry the last
    good pass copied. `encrypted` says the copy sits in an encrypted image (config `encrypted`);
    `verified` means rsync finished without error, which checks each file it moved. A second row
    per entry is off-site once the hub's backup has held the copy's source since that pass.

    The personal pass adds one row per path of a data set it has copied (`copied_paths`; a set
    still waiting earns none), unless a full-pass row already covers that path: placement counts
    rows, so two rows for one copy would read as two copies. A row's pass is the newest good copy
    that wrote under its path, each personal set having its own, and off-site needs the hub's
    backup to have held the source since then. `held_at` is that time, or a function of the pass
    time."""
    held = held_at if callable(held_at) else (lambda since: held_at)
    personal = status.get("personal") or {}
    full_pass = status.get("last_success_epoch") if status.get("total_bytes") else None
    wrote = [(p, s["last_success_epoch"]) for s in personal.get("sets") or [] if s.get("last_success_epoch")
             for p in s.get("paths") or []]

    def newest(top):
        return max([when for p, when in wrote if p == top or p.startswith(top + "/")], default=0)

    skip = set(excepted(cfg["exclude"]))
    copied = [p for p in (personal.get("copied_paths") or []) if personal.get("total_bytes") and newest(p)
              and not any(p == e or p.startswith(e + "/") for e in skip)]
    found = []
    for name in sorted(entries) if full_pass else []:
        if name.startswith(".") or name in skip:
            continue
        found.append((name, max(full_pass, newest(name)), status["total_bytes"]))
    tops = {name for name, _, _ in found}
    found += [(p, newest(p), personal["total_bytes"]) for p in copied if p.split("/")[0] not in tops]
    rows = []
    for path, since, size in found:
        inner = sorted(e for e in skip if e.startswith(path + "/"))
        base = {"path": path, "bytes": size, "verified": True, "except": inner, "pass": since}
        rows.append(dict(base, volume=cfg.get("volume") or cfg["hub"], encrypted=bool(cfg.get("encrypted"))))
        when = held(since)
        if when and when >= since:
            rows.append(dict(base, volume=cfg["offsite"].get("name", "offsite"), encrypted=True,
                             offsite=True, held_at=when))
    return rows


def offsite_held_at(cfg, run=subprocess.run, after_epoch=None):
    """When the hub's backup last succeeded with the source holding this copy, or None."""
    off = cfg.get("offsite") or {}
    if not off.get("status") or not off.get("source"):
        return None
    try:
        done = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                    f"cat {off['status']}"], capture_output=True, text=True, timeout=60)
        data = json.loads(done.stdout)
        if after_epoch and (data.get("last_start", {}).get("at") or 0) < after_epoch:
            return None
        held = data.get("held") or {}
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return None
    return held.get(off["source"])


def held_since(cfg, run=subprocess.run):
    """offsite_held_at as a function of the pass time; the hub is asked once per distinct time."""
    seen = {}

    def held(since):
        if since not in seen:
            seen[since] = offsite_held_at(cfg, run, after_epoch=since)
        return seen[since]
    return held


def write_replicas(rows):
    target = pathlib.Path(os.environ.get("HOME_MIRROR_REPLICAS",
                                         HOME / ".local/state/placement/replicas.d/home-mirror.json"))
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".json.tmp")
    tmp.write_text(json.dumps({"copies": rows}, indent=1) + "\n")
    os.replace(tmp, target)


def write_status(status):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "status.json.tmp"
    tmp.write_text(json.dumps(status, indent=1) + "\n")
    os.replace(tmp, STATE / "status.json")


STOPPED = "deferred: laptop activity, power or network changed; partial copy retained"


def set_logs(name):
    """A personal set's plan and copy logs, in a folder of their own that the copy leaves out."""
    slug = re.sub(r"[^A-Za-z0-9]+", "-", name).strip("-").lower() or "set"
    return STATE / "personal" / f"{slug}.plan.log", STATE / "personal" / f"{slug}.rsync.log"


def copy_pass(cfg, rec, save, now, dry, shared, sources=None, promised=0.0):
    """One copy, recorded in `rec` (its own part of status.json): the exclude list, a size plan
    checked against the free space, then the copy, which yields the hub's disk slot after `slice_s`
    and resumes next time. `sources` makes it one personal data set, named by `rec`: it always
    plans, and its space check is its own plan plus the reserve; a dry run stops at that plan, with
    `promised` GB already spoken for by the sets planned before it. `shared` carries the exclude
    list from one copy of a run to the next, so cloud placeholders are scanned once."""
    plan_log, log = (STATE / "preflight.log", STATE / "rsync.log") if sources is None else set_logs(rec["name"])
    log.parent.mkdir(parents=True, exist_ok=True)
    rec.update(attempt_epoch=now)
    for old_result in ('rc', 'duration_s'):
        rec.pop(old_result, None)
    exclude_file = STATE / "exclude.txt"
    if "lines" not in shared and "failed" not in shared:
        rec["state"] = "preparing: checking cloud placeholders"
        save()
        try:
            # The personal sets' logs change while a copy runs and are no part of the home's data.
            own = [rsync_pattern(str((STATE / "personal").relative_to(HOME))) + "/"] if HOME in STATE.parents else []
            placeholders = dataless(HOME, cfg["skip_dataless"])
            shared.update(lines=list(cfg["exclude"]) + own + [rsync_pattern(rel) for rel in placeholders],
                          dataless=len(placeholders))
            exclude_file.write_text("\n".join(shared["lines"]) + "\n")
        except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
            shared["failed"] = f"failed: {exc}"
    if "failed" in shared:
        rec["state"] = shared["failed"]
        return rec
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(now))
    if cfg.get("preflight_space") or sources is not None:
        rec["state"] = "preflight: waiting for disk and checking incremental size"
        save()
        with plan_log.open("w") as handle:
            plan = guarded_copy(rsync_args(cfg, exclude_file, stamp, dry=True, sources=sources), handle,
                                dict(cfg, slice_s=0))
        plan_text = plan_log.read_text(errors="replace")
        planned = stats(plan_text)
        if plan.returncode not in (0, 24) or "bytes" not in planned:
            if re.search(r"disk-slot:.*(?:is busy|not started)", plan_text):
                rec["state"] = "deferred: hub disk busy (disk-slot)"
            elif "destination reserve changed" in plan_text:
                rec["state"] = "deferred: destination reserve changed"
            elif plan.returncode == 75 and "Deferred:" in plan_text:
                rec["state"] = STOPPED
            else:
                rec["state"] = f"failed: capacity preflight (see {plan_log.relative_to(STATE)})"
            return rec
        free = remote_free_gb(cfg)
        free = free - promised if free is not None and promised else free
        needed = needed_gb(cfg, planned["bytes"])
        rec.update(planned_bytes=planned["bytes"], required_free_gb=needed)
        if free is None or free < needed:
            rec["state"] = (f"waiting for space: {free} GB free, {'incremental pass' if sources is None else 'this set'} "
                            f"needs {needed:.1f} GB including reserve")
            return rec
        if dry and sources is not None:
            rec["state"] = "dry run: fits"
            return rec
        cfg = dict(cfg, required_free_gb=needed)
    rec.update(state="running", attempt_epoch=now)
    save()
    with open(log, "w") as handle:
        done = guarded_copy(["/usr/bin/caffeinate", "-is",
                             *rsync_args(cfg, exclude_file, stamp, dry, sources=sources)], handle, cfg)
    text = log.read_text(errors="replace")[-20000:]
    rec.update(stats(text), rc=done.returncode, duration_s=int(time.time()) - now, dataless_skipped=shared["dataless"])
    # 24: some files vanished while copying (a live home): the pass still counts.
    if done.returncode in (0, 24) and not dry:
        rec.update(state="ok", last_success_epoch=int(time.time()))
        rec.setdefault("first_success_epoch", rec["last_success_epoch"])
    elif not dry and done.returncode == 75 and "Slice used (" in text:
        rec["state"] = "slice used, continues"
    elif not dry and done.returncode == 75 and "Deferred:" in text:
        rec["state"] = STOPPED   # the laptop came into use, lost mains or went metered: not a failure
    elif not dry and re.search(r"disk-slot:.*(?:is busy|not started)", text):
        rec["state"] = "deferred: hub disk busy (disk-slot)"
    elif not dry and "destination reserve changed" in text:
        rec["state"] = "deferred: destination reserve changed"
    else:
        rec["state"] = "dry run" if dry else f"failed: rsync exit {done.returncode} (see {log.relative_to(STATE)})"
    return rec


def personal_walk(cfg, personal, todo, free, save, now, dry, force, shared):
    """The personal pass: each data set that is due, in order, on its own. A set is planned alone
    and copied when its plan and the reserve fit in what is free now; one that does not fit waits,
    with the room it needs recorded, and the walk goes on, so a large set never holds back the
    small ones after it. A set that uses its slice, or is asked to yield, ends the walk for this
    run: the sets already copied are not due next time, so the next run resumes at that set.
    Returns (that set or None, the free space now)."""
    promised = 0.0
    for index, rec in enumerate(todo):
        if free - promised < float(cfg["min_free_gb"]):
            rec["state"] = f"skipped: {free - promised:.0f} GB free at the destination (floor {cfg['min_free_gb']})"
            continue
        if not force and not dry and still_waiting(cfg, rec, free, now):
            continue
        copy_pass(cfg, rec, save, now, dry, shared, sources=rec["paths"], promised=promised)
        if rec.get("rc") is not None:
            personal["rc"] = rec["rc"]
        if rec.get("rc") == 75 or rec["state"].startswith("deferred"):
            for later in todo[index + 1:]:
                later["state"] = f"queued: {rec['name']} goes first"
            return rec, free
        if rec["state"].startswith("dry run"):
            promised += rec["planned_bytes"] / 1e9
        elif rec.get("rc") is not None:
            free = remote_free_gb(cfg)
            if free is None:
                for later in todo[index + 1:]:
                    later["state"] = "skipped: hub unreachable or destination missing"
                return None, None
    return None, free


def run_once(cfg, force=False, dry=False, full=True):
    """The personal pass, then the full one (unless `full` is off), each when due. The personal
    pass is never held up by the full pass's space checks: those come after it and stop only the
    full pass."""
    now = int(time.time())
    try:
        previous = json.loads((STATE / "status.json").read_text())
    except (OSError, ValueError):
        previous = {}
    status = dict(previous, checked_at=now)
    personal = status["personal"] = dict(previous.get("personal") or {})
    wanted = personal_sets(cfg)
    if not wanted["state"]:
        # A set keeps its record only while it means the same paths: a changed set is not yet copied.
        old = {s.get("name"): s for s in personal.get("sets") or [] if isinstance(s, dict)}
        personal.update(skipped=wanted["skipped"], paths=sorted({p for s in wanted["sets"] for p in s["paths"]}),
                        sets=[dict(old[s["name"]] if old.get(s["name"], {}).get("paths") == s["paths"] else {}, **s)
                              for s in wanted["sets"]])

    def save():
        if not dry:
            summarise(personal, cfg, wanted["state"])
            write_status(status)

    passes(cfg, status, [] if wanted["state"] else personal["sets"], previous, save, now, force, dry, full)
    summarise(personal, cfg, wanted["state"])
    return status


def passes(cfg, status, sets, previous, save, now, force, dry, full):
    """The checks both passes share (link, power, hub), then the personal sets that are due, then
    the full pass with its own space checks."""
    personal, last = status["personal"], previous.get("last_success_epoch")

    def due(rec):
        done = rec.get("last_success_epoch")
        return force or not done or now - int(done) >= float(cfg["every_h"]) * 3600

    todo = [s for s in sets if due(s)]
    for s in sets:
        s["state"] = s.get("state") or "not run yet" if s in todo else "ok"
    do_personal, do_full = bool(todo), full and due(previous)
    if full and not do_full:
        status["state"] = "ok"
    if not (do_personal or do_full):
        return status

    def stop(state):
        """Neither pass can start now; each pass that was due, and each set, records why."""
        for s in todo:
            s["state"] = state
        if do_full:
            status["state"] = state
        return status

    if METERED.exists():
        return stop("skipped: metered link")
    if cfg["require_ac"] and not on_ac():
        return stop("skipped: on battery")
    if not idle_allowed(cfg):
        return stop("skipped: shared laptop is in use")
    if priority_busy(cfg):
        return stop('deferred: hub archive verification has priority (or hub check unavailable)')
    mounted = False
    if cfg.get("hub_mount"):
        check = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                                f"/usr/sbin/diskutil info -plist {sh(cfg['hub_mount'])}"],
                               capture_output=True, timeout=60)
        import plistlib
        try:
            mounted = plistlib.loads(check.stdout).get("MountPoint") == cfg["hub_mount"]
        except (ValueError, plistlib.InvalidFileException):
            mounted = False
    if cfg.get("hub_prepare") and not mounted:
        # E.g. attach the encrypted image the copy lives in (`home-mirror hub-attach` on the hub).
        # hub_password_service: this Mac's keychain item for the image password, piped to hub-attach on stdin
        # (newline stripped; never printed or written). Without it the hub falls back to its own password_cmd.
        secret = b""
        if cfg.get("hub_password_service"):
            got = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", cfg["hub_password_service"], "-w"],
                                 capture_output=True, timeout=60)
            secret = got.stdout.rstrip(b"\n") if got.returncode == 0 else b""
        try:
            done = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                                   cfg["hub_prepare"]], input=secret, capture_output=True, timeout=900)
            done.stdout, done.stderr = done.stdout.decode(errors="replace"), done.stderr.decode(errors="replace")
            ok, why = done.returncode == 0, (done.stdout + done.stderr).strip()[-200:]
        except (OSError, subprocess.SubprocessError) as exc:
            ok, why = False, str(exc)
        if not ok:
            return stop(f"skipped: the hub could not prepare the destination ({why})")
    free = remote_free_gb(cfg)
    if free is None:
        return stop("skipped: hub unreachable or destination missing")
    shared = {}
    if do_personal:
        personal.update(attempt_epoch=now)
        personal.pop("rc", None)
        yielded, free = personal_walk(cfg, personal, todo, free, save, now, dry, force, shared)
        personal.update(duration_s=int(time.time()) - now, dataless_skipped=shared.get("dataless", 0))
        if yielded:
            # Its slice is used, or the laptop or the hub's disk asked it to yield. The full pass
            # does not start in the same run: it would take the slot the personal pass gave up.
            if do_full:
                status["state"] = f"deferred: personal pass goes first ({yielded['name']}: {yielded['state']})"
            return status
    if not do_full:
        return status
    if free is None:
        status["state"] = "skipped: hub unreachable or destination missing"
        return status
    if last is None and not cfg.get("preflight_space") and free < float(cfg.get("first_pass_free_gb") or 0):
        status["state"] = f"waiting for space: {free:.0f} GB free, first pass needs {cfg.get('first_pass_free_gb')}"
        return status
    if free < float(cfg["min_free_gb"]):
        status["state"] = f"skipped: {free:.0f} GB free at the destination (floor {cfg['min_free_gb']})"
        return status
    if cfg.get('preflight_space') and not force and not dry:
        cached = cached_capacity(cfg, free, now)
        if cached:
            status.update(cached)
            return status
    copy_pass(cfg, status, save, now, dry, shared)
    return status


def hub_attach(path=None, run=subprocess.run, ismount=os.path.ismount, exists=os.path.exists, stdin=None):
    """On the hub: make sure the encrypted image is attached. Exit 0 when its volume is mounted.
    The password comes from stdin when the caller pipes one (a laptop sends its own keychain's value: the hub's
    keychain is locked to ssh sessions), else from password_cmd."""
    cfg = json.loads(pathlib.Path(path or HOME / ".config/fleet/home-mirror-hub.json").read_text())
    mount = os.path.join(cfg.get("volumes_root", "/Volumes"), cfg["volname"])
    if ismount(mount):
        return 0
    if stdin is None:
        stdin = b"" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.buffer.read()
    password = stdin.rstrip(b"\n")
    if not password:
        password = run(["/bin/zsh", "-c", cfg["password_cmd"]], capture_output=True, timeout=60).stdout or b""
        password = password.rstrip(b"\n")
    if not password:
        print("hub-attach: no password from password_cmd", file=sys.stderr)
        return 1
    image = cfg["image"]
    root = cfg.get("volumes_root", "/Volumes")
    rel = os.path.relpath(image, root)
    if not rel.startswith(".."):
        # The image lives on a drive. If that drive is not mounted, a stale empty folder of its name
        # would make "missing image" look true and hdiutil would create a new image on the boot disk.
        drive = os.path.join(root, rel.split(os.sep)[0])
        if not ismount(drive):
            print(f"hub-attach: {drive} is not mounted; not creating or attaching the image", file=sys.stderr)
            return 1
    if not exists(image):
        made = run(["/usr/bin/hdiutil", "create", "-size", cfg.get("size", "1000g"), "-type", "SPARSEBUNDLE",
                    "-fs", "APFS", "-encryption", "AES-256", "-stdinpass", "-volname", cfg["volname"], image],
                   input=password, capture_output=True, timeout=600)
        if made.returncode != 0:
            print(f"hub-attach: create failed: {(made.stderr or b'').decode(errors='replace')[-200:]}", file=sys.stderr)
            return 1
    done = run(["/usr/bin/hdiutil", "attach", "-nobrowse", "-stdinpass", image],
               input=password, capture_output=True, timeout=300)
    if done.returncode != 0 or not ismount(mount):
        print(f"hub-attach: attach failed: {(done.stderr or b'').decode(errors='replace')[-200:]}", file=sys.stderr)
        return 1
    return 0


def hub_trigger(host, run=subprocess.run, out=sys.stdout):
    """Trigger `home-mirror run` on a peer host over ssh; treat an unreachable sleeping peer (ssh 255) as a clean skip."""
    if not host or not re.fullmatch(r"[A-Za-z0-9._-]+", host) or host.startswith("-"):
        raise ValueError(f"invalid host: {host!r}")
    probe = run(["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
                 "-o", "ServerAliveInterval=30", host, "true"],
                capture_output=True, text=True, errors="replace", timeout=30)
    if probe.returncode == 255:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        print(f"{stamp} home-mirror: {host} unreachable (asleep?); skipping", file=out)
        return 0
    if probe.returncode != 0:
        msg = (probe.stderr or probe.stdout or "").strip()
        if msg:
            print(msg, file=out)
        return probe.returncode
    done = run(["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20",
                "-o", "ServerAliveInterval=30", host, '"$HOME/.local/bin/home-mirror" run'],
               text=True, errors="replace")
    return done.returncode


def main(argv=None):
    parser = argparse.ArgumentParser(prog="home-mirror", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--force", action="store_true")
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("--personal", action="store_true", help="the personal pass only; the full pass is left alone")
    sub.add_parser("status")
    sub.add_parser("hub-attach")
    ht = sub.add_parser("hub-trigger")
    ht.add_argument("host")
    args = parser.parse_args(argv)
    if args.cmd == "hub-attach":
        return hub_attach()
    if args.cmd == "hub-trigger":
        return hub_trigger(args.host)
    if args.cmd == "status":
        path = STATE / "status.json"
        print(path.read_text() if path.exists() else "no status yet")
        return 0
    def stopped(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stopped)
    cfg = load_config()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = (STATE / "run.lock").open("a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("home-mirror: another pass is running")
        return 0
    status = run_once(cfg, force=args.force, dry=args.dry_run, full=not args.personal)
    if not args.dry_run:
        write_status(status)
        if status.get("last_success_epoch") or status["personal"].get("sets"):
            write_replicas(replica_rows(cfg, status, os.listdir(HOME), held_since(cfg)))
    print(json.dumps(status, indent=1))
    states = (status.get("state"), status["personal"].get("state"))
    return 1 if any(str(state or "").startswith("failed") for state in states) else 0


if __name__ == "__main__":
    sys.exit(main())
