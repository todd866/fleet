#!/usr/bin/env python3
"""home-mirror: copy this Mac's home folder to the home hub, so the hub's backup can take it off-site.

A laptop's own backup client is the thing being avoided (IDrive's macOS app). Instead the laptop
pushes its home to a folder on the hub over ssh, once a day, when it is on an unmetered link and on
mains power; the hub's `idrive-ingest` backs that folder up with everything else. The hub copy is
also the "verified on the hub" half of an offload.

  home-mirror run [--force] [--dry-run]   one pass when due (or --force); writes status.json
  home-mirror status                       status.json

Config ~/.config/fleet/home-mirror.json:
  {"hub": "hub", "dest": "/Volumes/Drive/laptop-home", "every_h": 20, "min_free_gb": 40,
   "require_ac": true, "exclude": ["/Library/Caches/", "node_modules/"],
   "skip_dataless": ["Desktop", "Documents"]}
`exclude` lines are rsync patterns, anchored at the home folder when they start with "/"; a line may
be {"pattern": ..., "why": ...} so every skip says why (a coverage audit reads the reasons).
`first_pass_free_gb`: the first pass waits until the destination has this much free.
Files that are cloud placeholders (dataless) under `skip_dataless` are never read: reading one
makes the cloud download it. Deleted or changed files are moved to `<dest>-versions/<stamp>` on
the hub, not lost. On the hub the copy runs under `disk-slot`, so it never shares a disk with
another heavy job. State: ~/.local/state/home-mirror/.

A laptop's home holds keys and personal files, so on a removable drive the copy belongs inside an
encrypted disk image: set "hub_prepare": "~/.local/bin/home-mirror hub-attach", point `dest` into
the image's volume and `free_path` at the drive that holds it. On the hub, `home-mirror
hub-attach` reads ~/.config/fleet/home-mirror-hub.json:
  {"image": "<drive>/laptop-home.sparsebundle", "volname": "Laptop-Home", "size": "1300g",
   "password_cmd": "a command that prints the image password"}
and attaches the image, creating it (APFS, AES-256) on first use. The password goes from
`password_cmd` to hdiutil on stdin; it is never printed or written.
"""
import argparse
import fcntl
import json
import os
import pathlib
import re
import signal
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("HOME_MIRROR_CONFIG", HOME / ".config/fleet/home-mirror.json"))
STATE = pathlib.Path(os.environ.get("HOME_MIRROR_STATE", HOME / ".local/state/home-mirror"))
RSYNC = next((p for p in ("/opt/homebrew/bin/rsync", "/usr/local/bin/rsync") if os.path.exists(p)), "rsync")
REMOTE_RSYNC = "/opt/homebrew/bin/rsync"
METERED = HOME / ".local/state/METERED_LINK"
WILD = re.compile(r"([*?\[\]\\])")


def load_config(path=CONFIG):
    cfg = json.loads(pathlib.Path(path).read_text())
    cfg.setdefault("every_h", 20)
    cfg.setdefault("min_free_gb", 40)
    cfg.setdefault("require_ac", True)
    cfg.setdefault("exclude", [])
    cfg.setdefault("skip_dataless", [])
    cfg.setdefault("first_pass_free_gb", 0)
    cfg["exclude"] = [e["pattern"] if isinstance(e, dict) else e for e in cfg["exclude"]]
    for key in ("hub", "dest"):
        if not cfg.get(key):
            raise SystemExit(f"home-mirror: config needs {key}")
    return cfg


def rsync_pattern(rel):
    """An anchored rsync pattern matching exactly this relative path (wildcards escaped)."""
    return "/" + WILD.sub(r"\\\1", rel)


def dataless(home, folders, run=subprocess.run):
    """Relative paths of cloud placeholder files under these folders (BSD find -flags)."""
    out = []
    for folder in folders:
        root = home / folder
        if not root.is_dir():
            continue
        done = run(["/usr/bin/find", str(root), "-flags", "+dataless", "-type", "f"],
                   capture_output=True, text=True, errors="replace", timeout=1800)
        if getattr(done, "returncode", 0) != 0:
            raise RuntimeError(f"placeholder scan failed for {folder}; refusing to read cloud files")
        for line in done.stdout.splitlines():
            if line.startswith(str(home) + "/"):
                out.append(line[len(str(home)) + 1:])
    return out


def on_ac(run=subprocess.run):
    try:
        out = run(["pmset", "-g", "batt"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "AC Power" in out


def idle_allowed(cfg):
    if not cfg.get("require_idle"):
        return True
    try:
        if os.stat("/dev/console").st_uid != os.getuid():
            return False
        result = subprocess.run(["/usr/sbin/ioreg", "-c", "IOHIDSystem"],
                                capture_output=True, text=True, timeout=10)
        found = re.search(r'"HIDIdleTime"\s*=\s*(\d+)', result.stdout)
        return bool(found and int(found.group(1)) >= int(cfg.get("idle_seconds", 300)) * 10**9)
    except (OSError, subprocess.SubprocessError):
        return False


def guarded_copy(args, handle, cfg):
    """End our process group cleanly if the shared laptop becomes active or loses mains."""
    child = subprocess.Popen(args, stdout=handle, stderr=subprocess.STDOUT, start_new_session=True)
    try:
        while True:
            try:
                return subprocess.CompletedProcess(args, child.wait(timeout=15))
            except subprocess.TimeoutExpired:
                if not idle_allowed(cfg) or (cfg.get("require_ac") and not on_ac()) or METERED.exists():
                    handle.write("\nDeferred: laptop activity, power or network changed; partial copy retained.\n")
                    return subprocess.CompletedProcess(args, 75)
    finally:
        if child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            child.wait()


def priority_busy(cfg, run=subprocess.run):
    """Yield new attempts to an already-running hub archive batch; never stop a copy."""
    lock = cfg.get('hub_priority_lock')
    if not lock:
        return False
    try:
        check = run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg['hub'],
                     '/usr/bin/lockf -t 0 ' + sh(lock) + ' /usr/bin/true'],
                    capture_output=True, timeout=30)
        return check.returncode != 0
    except (OSError, subprocess.SubprocessError):
        return True


def cached_capacity(cfg, free, now):
    """Only defer from a recent plan. Never authorize a copy using cached capacity."""
    log = STATE / 'preflight.log'
    try:
        age = now - log.stat().st_mtime
        if age < 0 or age > float(cfg.get('preflight_cache_h', 6)) * 3600:
            return None
        planned = stats(log.read_text(errors='replace'))
        if 'bytes' not in planned:
            return None
        needed = planned['bytes'] / 1e9 * 1.10 + float(cfg['min_free_gb'])
        if free < needed:
            return dict(planned_bytes=planned['bytes'], required_free_gb=needed,
                        state=f'waiting for space: {free:.1f} GB free, recent plan needs {needed:.1f} GB including reserve')
    except (OSError, ValueError, TypeError):
        pass
    return None


def remote_free_gb(cfg, run=subprocess.run):
    # `free_path`: where free space is really measured. Inside a sparse disk image the image's own
    # size shows as free; the drive that holds the image is what fills up.
    parent = cfg.get("free_path") or os.path.dirname(cfg["dest"].rstrip("/")) or "/"
    try:
        done = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                    f"/bin/df -k {sh(parent)} | tail -1"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    parts = done.stdout.split()
    if done.returncode != 0 or len(parts) < 4 or not parts[3].isdigit():
        return None
    return int(parts[3]) * 1024 / 1e9


def sh(text):
    return "'" + str(text).replace("'", "'\\''") + "'"


def rsync_args(cfg, exclude_file, stamp, dry=False, verify=False):
    dest = cfg["dest"].rstrip("/")
    remote = (f"$HOME/.local/bin/disk-slot --label home-mirror --wait 7200 {sh(os.path.dirname(dest))} -- "
              f"{REMOTE_RSYNC}")
    if cfg.get("required_free_gb") and not dry:
        floor = int(float(cfg["required_free_gb"]) * 1e9 / 1024)
        check_path = cfg.get("free_path") or os.path.dirname(dest)
        script = (f"available=$(df -Pk {sh(check_path)} | awk 'NR==2 {{print $4}}'); "
                  f"[ \"${{available:-0}}\" -ge {floor} ] || {{ echo 'destination reserve changed' >&2; exit 75; }}; "
                  f'exec {REMOTE_RSYNC} "$@"')
        remote = (f"$HOME/.local/bin/disk-slot --label home-mirror --wait 7200 {sh(os.path.dirname(dest))} -- "
                  f"/bin/sh -c {sh(script)} home-mirror")
    args = [RSYNC, "-aHX", "--delete", "--delete-excluded", "--partial", "--stats",
            "--backup", f"--backup-dir={dest}-versions/{stamp}",
            "--exclude-from", str(exclude_file), "--rsync-path", remote,
            "-e", "ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30"]
    if cfg.get("bwlimit_kib"):
        args.append(f"--bwlimit={int(cfg['bwlimit_kib'])}")
    if verify:
        args += ["--checksum", "--itemize-changes"]
    if dry or verify:
        args.append("--dry-run")
    return args + [str(HOME) + "/", f"{cfg['hub']}:{dest}/"]


def stats(text):
    out = {}
    for key, label in (("files", "Number of regular files transferred"),
                       ("bytes", "Total transferred file size"), ("total_bytes", "Total file size")):
        hit = re.search(label + r":\s*([\d,]+)", text or "")
        if hit:
            out[key] = int(hit.group(1).replace(",", ""))
    return out


def excepted(patterns):
    """Home-relative folders the copy leaves out: the anchored, wildcard-free excludes."""
    out = []
    for p in patterns:
        if p.startswith("/") and not WILD.search(p):
            rel = p.strip("/")
            if rel:
                out.append(rel)
    return sorted(set(out))


def replica_rows(cfg, status, entries, held_at=None):
    """Rows for placement (replicas.d/home-mirror.json): one per top-level home entry the last
    good pass copied. `encrypted` says the copy sits in an encrypted image (config `encrypted`);
    `verified` means rsync finished without error, which checks each file it moved. A second row
    per entry is off-site once the hub's backup has held the copy's source since that pass."""
    first = status.get("first_success_epoch")
    if not status.get("last_success_epoch") or not status.get("total_bytes"):
        return []
    skip = set(excepted(cfg["exclude"]))
    rows = []
    for name in sorted(entries):
        if name.startswith(".") or name in skip:
            continue
        inner = [e for e in skip if e.startswith(name + "/")]
        base = {"path": name, "bytes": status["total_bytes"], "verified": True, "except": inner,
                "pass": status["last_success_epoch"]}
        rows.append(dict(base, volume=cfg.get("volume") or cfg["hub"], encrypted=bool(cfg.get("encrypted"))))
        if held_at and held_at >= status["last_success_epoch"]:
            rows.append(dict(base, volume=cfg["offsite"].get("name", "offsite"), encrypted=True,
                             offsite=True, held_at=held_at))
    return rows


def offsite_held_at(cfg, run=subprocess.run, after_epoch=None):
    """When the hub's backup last succeeded with the source holding this copy, or None."""
    off = cfg.get("offsite") or {}
    if not off.get("status") or not off.get("source"):
        return None
    try:
        done = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                    f"cat {off['status']}"], capture_output=True, text=True, timeout=60)
        data = json.loads(done.stdout)
        if after_epoch and (data.get("last_start", {}).get("at") or 0) < after_epoch:
            return None
        held = data.get("held") or {}
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return None
    return held.get(off["source"])


def write_replicas(rows):
    target = pathlib.Path(os.environ.get("HOME_MIRROR_REPLICAS",
                                         HOME / ".local/state/placement/replicas.d/home-mirror.json"))
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".json.tmp")
    tmp.write_text(json.dumps({"copies": rows}, indent=1) + "\n")
    os.replace(tmp, target)


def write_status(status):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "status.json.tmp"
    tmp.write_text(json.dumps(status, indent=1) + "\n")
    os.replace(tmp, STATE / "status.json")


def run_once(cfg, force=False, dry=False):
    now = int(time.time())
    try:
        previous = json.loads((STATE / "status.json").read_text())
    except (OSError, ValueError):
        previous = {}
    status = dict(previous, checked_at=now)
    last = previous.get("last_success_epoch")
    if not force and last and now - int(last) < float(cfg["every_h"]) * 3600:
        status["state"] = "ok"
        return status
    if METERED.exists():
        status["state"] = "skipped: metered link"
        return status
    if cfg["require_ac"] and not on_ac():
        status["state"] = "skipped: on battery"
        return status
    if not idle_allowed(cfg):
        status["state"] = "skipped: shared laptop is in use"
        return status
    if priority_busy(cfg):
        status['state'] = 'deferred: hub archive verification has priority (or hub check unavailable)'
        return status
    mounted = False
    if cfg.get("hub_mount"):
        check = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                                f"/usr/sbin/diskutil info -plist {sh(cfg['hub_mount'])}"],
                               capture_output=True, timeout=60)
        import plistlib
        try:
            mounted = plistlib.loads(check.stdout).get("MountPoint") == cfg["hub_mount"]
        except (ValueError, plistlib.InvalidFileException):
            mounted = False
    if cfg.get("hub_prepare") and not mounted:
        # E.g. attach the encrypted image the copy lives in (`home-mirror hub-attach` on the hub).
        # hub_password_service: this Mac's keychain item for the image password, piped to hub-attach on stdin
        # (newline stripped; never printed or written). Without it the hub falls back to its own password_cmd.
        secret = b""
        if cfg.get("hub_password_service"):
            got = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", cfg["hub_password_service"], "-w"],
                                 capture_output=True, timeout=60)
            secret = got.stdout.rstrip(b"\n") if got.returncode == 0 else b""
        try:
            done = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", cfg["hub"],
                                   cfg["hub_prepare"]], input=secret, capture_output=True, timeout=900)
            done.stdout, done.stderr = done.stdout.decode(errors="replace"), done.stderr.decode(errors="replace")
            ok, why = done.returncode == 0, (done.stdout + done.stderr).strip()[-200:]
        except (OSError, subprocess.SubprocessError) as exc:
            ok, why = False, str(exc)
        if not ok:
            status["state"] = f"skipped: the hub could not prepare the destination ({why})"
            return status
    free = remote_free_gb(cfg)
    if free is None:
        status["state"] = "skipped: hub unreachable or destination missing"
        return status
    if last is None and not cfg.get("preflight_space") and free < float(cfg.get("first_pass_free_gb") or 0):
        status["state"] = f"waiting for space: {free:.0f} GB free, first pass needs {cfg.get('first_pass_free_gb')}"
        return status
    if free < float(cfg["min_free_gb"]):
        status["state"] = f"skipped: {free:.0f} GB free at the destination (floor {cfg['min_free_gb']})"
        return status
    if cfg.get('preflight_space') and not force and not dry:
        cached = cached_capacity(cfg, free, now)
        if cached:
            status.update(cached)
            return status
    STATE.mkdir(parents=True, exist_ok=True)
    status.update(attempt_epoch=now)
    for old_result in ('rc', 'duration_s'):
        status.pop(old_result, None)
    exclude_file = STATE / "exclude.txt"
    if not dry:
        write_status(dict(status, state="preparing: checking cloud placeholders", attempt_epoch=now))
    try:
        placeholders = dataless(HOME, cfg["skip_dataless"])
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        status["state"] = f"failed: {exc}"
        return status
    lines = list(cfg["exclude"]) + [rsync_pattern(rel) for rel in placeholders]
    exclude_file.write_text("\n".join(lines) + "\n")
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(now))
    if cfg.get("preflight_space"):
        if not dry:
            write_status(dict(status, state="preflight: waiting for disk and checking incremental size", attempt_epoch=now))
        plan_log = STATE / "preflight.log"
        with plan_log.open("w") as handle:
            plan = guarded_copy(rsync_args(cfg, exclude_file, stamp, dry=True), handle, cfg)
        planned = stats(plan_log.read_text(errors="replace"))
        if plan.returncode not in (0, 24) or "bytes" not in planned:
            status["state"] = "failed: capacity preflight (see preflight.log)"
            return status
        free = remote_free_gb(cfg)
        needed = planned["bytes"] / 1e9 * 1.10 + float(cfg["min_free_gb"])
        status.update(planned_bytes=planned["bytes"], required_free_gb=needed)
        if free is None or free < needed:
            status["state"] = f"waiting for space: {free} GB free, incremental pass needs {needed:.1f} GB including reserve"
            return status
        cfg = dict(cfg, required_free_gb=needed)
    status.update(state="running", attempt_epoch=now)
    if not dry:
        write_status(status)
    log = STATE / "rsync.log"
    with open(log, "w") as handle:
        done = guarded_copy(["/usr/bin/caffeinate", "-is", *rsync_args(cfg, exclude_file, stamp, dry)], handle, cfg)
    text = log.read_text(errors="replace")[-20000:]
    status.update(stats(text), rc=done.returncode, duration_s=int(time.time()) - now,
                  dataless_skipped=len(lines) - len(cfg["exclude"]))
    # 24: some files vanished while copying (a live home): the pass still counts.
    if done.returncode in (0, 24) and not dry:
        status.update(state="ok", last_success_epoch=int(time.time()))
        status.setdefault("first_success_epoch", status["last_success_epoch"])
    else:
        status["state"] = "dry run" if dry else f"failed: rsync exit {done.returncode} (see rsync.log)"
    return status


def hub_attach(path=None, run=subprocess.run, ismount=os.path.ismount, exists=os.path.exists, stdin=None):
    """On the hub: make sure the encrypted image is attached. Exit 0 when its volume is mounted.
    The password comes from stdin when the caller pipes one (a laptop sends its own keychain's value: the hub's
    keychain is locked to ssh sessions), else from password_cmd."""
    cfg = json.loads(pathlib.Path(path or HOME / ".config/fleet/home-mirror-hub.json").read_text())
    mount = os.path.join(cfg.get("volumes_root", "/Volumes"), cfg["volname"])
    if ismount(mount):
        return 0
    if stdin is None:
        stdin = b"" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.buffer.read()
    password = stdin.rstrip(b"\n")
    if not password:
        password = run(["/bin/zsh", "-c", cfg["password_cmd"]], capture_output=True, timeout=60).stdout or b""
        password = password.rstrip(b"\n")
    if not password:
        print("hub-attach: no password from password_cmd", file=sys.stderr)
        return 1
    image = cfg["image"]
    if not exists(image):
        made = run(["/usr/bin/hdiutil", "create", "-size", cfg.get("size", "1000g"), "-type", "SPARSEBUNDLE",
                    "-fs", "APFS", "-encryption", "AES-256", "-stdinpass", "-volname", cfg["volname"], image],
                   input=password, capture_output=True, timeout=600)
        if made.returncode != 0:
            print(f"hub-attach: create failed: {(made.stderr or b'').decode(errors='replace')[-200:]}", file=sys.stderr)
            return 1
    done = run(["/usr/bin/hdiutil", "attach", "-nobrowse", "-stdinpass", image],
               input=password, capture_output=True, timeout=300)
    if done.returncode != 0 or not ismount(mount):
        print(f"hub-attach: attach failed: {(done.stderr or b'').decode(errors='replace')[-200:]}", file=sys.stderr)
        return 1
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="home-mirror", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--force", action="store_true")
    r.add_argument("--dry-run", action="store_true")
    sub.add_parser("status")
    sub.add_parser("hub-attach")
    args = parser.parse_args(argv)
    if args.cmd == "hub-attach":
        return hub_attach()
    if args.cmd == "status":
        path = STATE / "status.json"
        print(path.read_text() if path.exists() else "no status yet")
        return 0
    def stopped(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stopped)
    cfg = load_config()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = (STATE / "run.lock").open("a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("home-mirror: another pass is running")
        return 0
    status = run_once(cfg, force=args.force, dry=args.dry_run)
    if not args.dry_run:
        write_status(status)
        if status.get("last_success_epoch"):
            held = offsite_held_at(cfg, after_epoch=status["last_success_epoch"])
            write_replicas(replica_rows(cfg, status, os.listdir(HOME), held))
    print(json.dumps(status, indent=1))
    return 0 if not str(status.get("state", "")).startswith("failed") else 1


if __name__ == "__main__":
    sys.exit(main())
