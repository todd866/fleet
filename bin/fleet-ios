#!/usr/bin/env python3
"""Build, test, archive, OTA-publish, pair, and device-install the Fleet iOS app."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import plistlib
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
IOS_DIR = ROOT / "ios"
PROJECT_YML = IOS_DIR / "project.yml"
XCODEPROJ = IOS_DIR / "Fleet.xcodeproj"
BUILD_DIR = IOS_DIR / "build"
IPA_PATH = BUILD_DIR / "Fleet.ipa"

DEFAULT_CONFIG: dict[str, Any] = {
    "hub_ssh": "hub",
    "hub_url": "https://hub.example.ts.net:8444",
    "ota_dir": "~/.local/state/fleet-api/ota",
    "device_id": "",
    "team_id": "",
    "bundle_id": "org.example.fleet",
    "widget_bundle_id": "org.example.fleet.widgets",
    "keychain_service": "fleet-api-token",
    "mc_primary_url": "",
    "mc_fallback_url": "",
    "mc_token_file": "",
    "asc_key_id": "",
    "asc_key_path": "",
    "asc_issuer_file": "",
}


def load_config(path: Path | None = None) -> dict[str, Any]:
    cfg_path = path or Path(os.environ.get("FLEET_IOS_CONFIG") or "~/.config/fleet/ios-config.json").expanduser()
    cfg = dict(DEFAULT_CONFIG)
    if cfg_path.is_file():
        data = json.loads(cfg_path.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            cfg.update({k: v for k, v in data.items() if v is not None})
    return cfg


def _run(cmd: list[str], *, env: dict[str, str] | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    print("+", " ".join(cmd), flush=True)
    return subprocess.run(cmd, env=env, text=True, check=check)


def cmd_generate(_cfg: dict[str, Any], _args: argparse.Namespace) -> int:
    _run(["xcodegen", "generate", "--spec", str(PROJECT_YML), "--project", str(IOS_DIR)])
    return 0


def cmd_test(cfg: dict[str, Any], args: argparse.Namespace) -> int:
    cmd_generate(cfg, args)
    _run([
        "xcodebuild",
        "-project", str(XCODEPROJ),
        "-scheme", "Fleet",
        "-destination", args.destination,
        "test",
    ])
    _run([
        "xcodebuild",
        "-project", str(XCODEPROJ),
        "-scheme", "FleetWidgets",
        "-destination", "generic/platform=iOS Simulator",
        "build",
    ])
    return 0


def _asc_flags(cfg: dict[str, Any]) -> list[str]:
    key_id = str(cfg.get("asc_key_id") or "").strip()
    key_path = Path(str(cfg.get("asc_key_path") or "")).expanduser() if cfg.get("asc_key_path") else None
    issuer_file = Path(str(cfg.get("asc_issuer_file") or "")).expanduser() if cfg.get("asc_issuer_file") else None
    issuer_id = os.environ.get("ASC_ISSUER_ID", "").strip()
    if not issuer_id and issuer_file and issuer_file.is_file():
        issuer_id = issuer_file.read_text(encoding="utf-8").strip()
    if key_id and key_path and key_path.is_file() and issuer_id:
        return [
            "-authenticationKeyPath", str(key_path),
            "-authenticationKeyID", key_id,
            "-authenticationKeyIssuerID", issuer_id,
        ]
    return []


def _verify_app(app_dir: Path) -> None:
    _run([str(ROOT / "bin" / "ios-verify-app-group"), str(app_dir),
          "--extension", "FleetWidgets.appex", "--group-info-key", "FleetAppGroup"])


def _archive_fleet(cfg: dict[str, Any], work: Path) -> Path:
    base = ["xcodebuild", "-project", str(XCODEPROJ), "-scheme", "Fleet",
            "-configuration", "Release", "-destination", "generic/platform=iOS"]
    archive = work / "Fleet.xcarchive"
    result = _run(base + ["-archivePath", str(archive), "-allowProvisioningUpdates",
                          *_asc_flags(cfg), "archive"], check=False)
    if result.returncode:
        print("Retrying with cached provisioning and the same entitlements...", flush=True)
        archive = work / "Cached.xcarchive"
        _run(base + ["-archivePath", str(archive), "archive"])
    app = archive / "Products" / "Applications" / "Fleet.app"
    _verify_app(app)
    with (app / "Info.plist").open("rb") as stream:
        info = plistlib.load(stream)
    receipt = {
        "verified_at": datetime.now(timezone.utc).isoformat(),
        "revision": cfg.get("_revision"), "dirty": cfg.get("_dirty"),
        "bundle_id": info["CFBundleIdentifier"], "build": info["CFBundleVersion"],
        "verified": ["archive signature and App Group on app and widget"],
    }
    (archive / "fleet-build.json").write_text(json.dumps(receipt, indent=2) + "\n")
    latest = BUILD_DIR / "Fleet.xcarchive"
    if latest.exists():
        _run(["trash", str(latest)])
    archive.rename(latest)
    return latest


def _export_ipa(cfg: dict[str, Any], archive: Path, work: Path) -> Path:
    export_dir = work / "export"
    team_id = str(cfg.get("team_id") or "").strip()
    opts: dict[str, Any] = {
        "method": "development",
        "signingStyle": "automatic",
        "compileBitcode": False,
        "thinning": "<none>",
    }
    if team_id:
        opts["teamID"] = team_id
    opts_path = work / "ExportOptions.plist"
    with opts_path.open("wb") as fh:
        plistlib.dump(opts, fh)

    # Use system-only PATH so Homebrew rsync does not break IDEDistributionCreateIPAStep.
    sys_env = dict(os.environ)
    sys_env["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
    asc = _asc_flags(cfg)
    _run(
        ["xcodebuild", "-exportArchive", "-archivePath", str(archive),
         "-exportOptionsPlist", str(opts_path), "-exportPath", str(export_dir)] + asc,
        env=sys_env,
    )
    exported = list(export_dir.glob("*.ipa"))
    if len(exported) != 1:
        raise RuntimeError(f"Expected one exported IPA, found {len(exported)}")
    payload_dir = work / "unpacked"
    _run(["/usr/bin/ditto", "-x", "-k", str(exported[0]), str(payload_dir)])
    _verify_app(payload_dir / "Payload" / "Fleet.app")
    with exported[0].open("rb") as stream:
        digest = hashlib.sha256(stream.read()).hexdigest()
    exported[0].replace(IPA_PATH)
    receipt_path = archive / "fleet-build.json"
    receipt = json.loads(receipt_path.read_text())
    receipt["ipa_sha256"] = digest
    receipt["verified"].append("export signature and App Group on app and widget")
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n")
    print(f"Verified export {IPA_PATH} sha256={digest}", flush=True)
    return IPA_PATH


def cmd_publish_ipa(cfg: dict[str, Any], args: argparse.Namespace) -> int:
    cmd_generate(cfg, args)
    with tempfile.TemporaryDirectory(dir=BUILD_DIR) as tmp:
        archive = _archive_fleet(cfg, Path(tmp))
        ipa = _export_ipa(cfg, archive, Path(tmp))
    if args.no_upload:
        print(f"Built {ipa} (upload skipped)")
        return 0
    hub_ssh = str(cfg.get("hub_ssh") or "").strip()
    ota_dir = str(cfg.get("ota_dir") or "~/.local/state/fleet-api/ota").rstrip("/")
    if not hub_ssh or hub_ssh == "hub":
        raise RuntimeError("Set hub_ssh in ~/.config/fleet/ios-config.json before uploading OTA")
    _run(["ssh", hub_ssh, f"mkdir -p {ota_dir}"], check=True)
    _run(["rsync", "-av", str(ipa), f"{hub_ssh}:{ota_dir}/Fleet.ipa.tmp"], check=True)
    _run(["ssh", hub_ssh, f"mv -f {ota_dir}/Fleet.ipa.tmp {ota_dir}/Fleet.ipa"], check=True)
    print(f"Published OTA IPA to {hub_ssh}:{ota_dir}/Fleet.ipa", flush=True)
    return 0


def cmd_install_device(cfg: dict[str, Any], args: argparse.Namespace) -> int:
    device_id = str(args.device or cfg.get("device_id") or "").strip()
    if not device_id:
        raise RuntimeError("No target device UDID set (--device or device_id in ios-config.json)")
    cmd_generate(cfg, args)
    with tempfile.TemporaryDirectory(dir=BUILD_DIR) as tmp:
        archive = _archive_fleet(cfg, Path(tmp))
        app = archive / "Products" / "Applications" / "Fleet.app"
        _run(["xcrun", "devicectl", "device", "install", "app", "--device", device_id, str(app)])
    return 0


def _build_pair_url(cfg: dict[str, Any]) -> str:
    service = str(cfg.get("keychain_service") or "fleet-api-token")
    hub_url = str(cfg.get("hub_url") or "").rstrip("/")
    res = subprocess.run(
        ["security", "find-generic-password", "-s", service, "-w"],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0 or not res.stdout.strip():
        raise RuntimeError(f"Could not read token from Keychain service {service!r}")
    tok = res.stdout.strip()
    params: list[tuple[str, str]] = [("url", hub_url), ("token", tok)]

    mc_primary = str(cfg.get("mc_primary_url") or "").strip().rstrip("/")
    mc_fallback = str(cfg.get("mc_fallback_url") or "").strip().rstrip("/")
    mc_tok_file = str(cfg.get("mc_token_file") or "").strip()
    if mc_primary and not mc_primary.endswith("example.ts.net") and mc_tok_file:
        tok_path = Path(mc_tok_file).expanduser()
        if not tok_path.is_file():
            raise RuntimeError(f"Missing Mission Control token file: {tok_path}")
        mc_tok = tok_path.read_text(encoding="utf-8").strip()
        if mc_tok:
            params.append(("mcUrl", mc_primary))
            if mc_fallback and mc_fallback != mc_primary and not mc_fallback.endswith("example.ts.net"):
                params.append(("mcFallback", mc_fallback))
            params.append(("mcToken", mc_tok))

    return "fleet://pair?" + urllib.parse.urlencode(params)


def cmd_pair_url(cfg: dict[str, Any], _args: argparse.Namespace) -> int:
    print(_build_pair_url(cfg))
    return 0


def cmd_pair_device(cfg: dict[str, Any], args: argparse.Namespace) -> int:
    device_id = str(args.device or cfg.get("device_id") or "").strip()
    if not device_id:
        raise RuntimeError("No target device UDID set (--device or device_id in ios-config.json)")
    bundle_id = str(cfg.get("bundle_id") or "").strip()
    if not bundle_id or bundle_id == "org.example.fleet":
        raise RuntimeError("Set bundle_id in ~/.config/fleet/ios-config.json before pairing")
    pair_url = _build_pair_url(cfg)
    print(f"+ xcrun devicectl device process launch --device {device_id} --payload-url <redacted> {bundle_id}", flush=True)
    res = subprocess.run(
        [
            "xcrun", "devicectl", "device", "process", "launch",
            "--device", device_id,
            "--payload-url", pair_url,
            bundle_id,
        ],
        capture_output=True,
        text=True,
    )
    if res.stdout:
        print(res.stdout.rstrip(), flush=True)
    if res.returncode != 0:
        if res.stderr:
            print(res.stderr.rstrip(), flush=True)
        return res.returncode
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Manage Fleet iOS builds, tests, OTA publishing, and device installs")
    ap.add_argument("--config", type=Path, default=None)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("generate", help="Run xcodegen to generate ios/Fleet.xcodeproj")

    p_test = sub.add_parser("test", help="Run Simulator unit tests and build widget extension")
    p_test.add_argument("--destination", default="platform=iOS Simulator,name=iPhone Duo")

    p_pub = sub.add_parser("publish-ipa", help="Archive Release IPA and rsync to hub OTA directory")
    p_pub.add_argument("--no-upload", action="store_true")

    p_inst = sub.add_parser("install-device", help="Install signed Fleet.app directly onto paired iPhone via devicectl")
    p_inst.add_argument("--device", default=None)

    sub.add_parser("pair-url", help="Print fleet://pair URL from local Keychain token")

    p_pair_dev = sub.add_parser("pair-device", help="Launch Fleet on paired iPhone with unified pairing payload")
    p_pair_dev.add_argument("--device", default=None)

    args = ap.parse_args(argv)
    # Acquire the scheduler slot before the checkout lock. A caller already running
    # under heavy-slot inherits its worker budget and can use that allocation.
    slot = shutil.which("heavy-slot")
    if args.cmd in {"test", "install-device", "publish-ipa"} and slot and "HEAVY_SLOT_WORKERS" not in os.environ:
        cli_args = sys.argv[1:] if argv is None else argv
        return subprocess.run([slot, "--", sys.executable, str(Path(__file__).resolve()), *cli_args]).returncode
    cfg = load_config(args.config)
    handlers = {
        "generate": cmd_generate,
        "test": cmd_test,
        "publish-ipa": cmd_publish_ipa,
        "install-device": cmd_install_device,
        "pair-url": cmd_pair_url,
        "pair-device": cmd_pair_device,
    }
    if args.cmd in {"generate", "test", "publish-ipa", "install-device"}:
        BUILD_DIR.mkdir(parents=True, exist_ok=True)
        with (BUILD_DIR / ".fleet-ios.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if (ROOT / ".git").exists():
                rev = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
                edits = subprocess.check_output(["git", "-C", str(ROOT), "status", "--porcelain"], text=True)
                cfg.update(_revision=rev, _dirty=bool(edits))
                print(f"Fleet {args.cmd} source {rev} ({'dirty' if edits else 'clean'})", flush=True)
            return handlers[args.cmd](cfg, args)
    return handlers[args.cmd](cfg, args)


if __name__ == "__main__":
    raise SystemExit(main())
